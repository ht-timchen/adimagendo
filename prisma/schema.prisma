// ADIMAGENDO - Study participant management
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  USER
  ADMIN
}

enum ChecklistItemType {
  SCAN
  BLOOD_TEST
  SURVEY
  UPLOAD
  APPOINTMENT
  OTHER
}

enum ChecklistStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum AbsenceReason {
  MEDICAL
  SYMPTOMS
  APPOINTMENT
  OTHER
}

enum DocumentType {
  REPORT_CARD
  REFERRAL
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

/// External booking (R03) checklist flow — not used for templates without externalUrl.
enum ChecklistBookingProgress {
  NOT_STARTED
  BOOKED_EXTERNALLY
  CONFIRMED
}

/// Where participant account data originated (app vs REDCap-linked enrolment).
enum ParticipantDataSource {
  LOCAL
  REDCAP
}

/// Study data classification for reporting and pilot filtering.
enum ParticipantDataKind {
  TEST
  REAL
  UNKNOWN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  image         String?
  role              Role      @default(PARTICIPANT)
  isActive          Boolean   @default(true) @map("active")
  superAdmin        Boolean   @default(false)
  inviteToken       String?
  inviteTokenExpiry DateTime?
  lastLoginAt       DateTime?
  dateOfBirth       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  profile          ParticipantProfile?
  checklist        ParticipantChecklistItem[]
  symptoms         SymptomEntry[]
  absences         AbsenceEntry[]
  surveyResponses  SurveyResponse[]
  appointments     Appointment[]
  documents        Document[]
  notifications    Notification[]
  contactMessages  ContactMessage[]
  pushSubscriptions PushSubscription[]
  milestones        ParticipantMilestone[]
  schoolAttendanceReminderCycles SchoolAttendanceReminderCycle[]
  medicalAppointmentsReminderCycles MedicalAppointmentsReminderCycle[]
  adminAuditEvents  AdminAuditEvent[] @relation("AdminAuditActor")
}

model AdminAuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  actorName   String
  actorRole   String
  action      String
  targetType  String
  targetId    String?
  targetName  String?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token     String?
  expires_at       Int?
  token_type       String?
  scope            String?
  id_token         String?
  session_state    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ParticipantProfile {
  id             String   @id @default(cuid())
  userId        String   @unique
  enrollmentDate DateTime
  studyPhase    String?  // e.g. "baseline", "3-month", etc.
  studyRecordId String?   // External / REDCap record mapping
  dataSource    ParticipantDataSource @default(LOCAL)
  dataKind      ParticipantDataKind   @default(TEST)
  firstName     String?
  lastName      String?
  phone         String?
  redcapType    String?
  consentStatus String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([studyRecordId])
}

model ChecklistTemplate {
  id             String           @id @default(cuid())
  key            String           @unique
  title          String
  description   String?
  type          ChecklistItemType
  externalUrl   String?
  dueOffsetDays Int?
  sortOrder     Int              @default(0)
  /// Explicit link to SurveyTemplate.key (SURVEY steps only).
  surveyTemplateKey String?
  /// Per-step REDCap instrument URL (replaces global constant at runtime).
  redcapUrl         String?
  /// ChecklistTemplate.key values that must be COMPLETED before this step unlocks.
  prerequisiteKeys  Json?
  /// Unlocks when this booking step has bookingProgress CONFIRMED or BOOKED_EXTERNALLY.
  bookingPrerequisiteKey String?
  /// Additional enrollment-based unlock: enrollmentDate + unlockOffsetDays.
  unlockOffsetDays  Int?
  /// Groups related steps for milestone evaluation (e.g. level_1_imaging).
  completionGroupKey String?
  /// StudyMilestone.key values that must be achieved before this step unlocks.
  requiredMilestoneKeys Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  surveyTemplate   SurveyTemplate? @relation(fields: [surveyTemplateKey], references: [key], onDelete: SetNull)
  participantItems ParticipantChecklistItem[]
}

/// Protocol milestone definition (metadata-driven; evaluated in application layer).
model StudyMilestone {
  key          String   @id
  title        String
  /// ChecklistTemplate.key values that must all be COMPLETED to achieve this milestone.
  requiredKeys Json
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  participantAchievements ParticipantMilestone[]
}

model ParticipantMilestone {
  id           String   @id @default(cuid())
  userId       String
  milestoneKey String
  achievedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone  StudyMilestone @relation(fields: [milestoneKey], references: [key], onDelete: Cascade)

  @@unique([userId, milestoneKey])
  @@index([userId])
}

model ParticipantChecklistItem {
  id         String         @id @default(cuid())
  userId     String
  templateId String
  status     ChecklistStatus @default(PENDING)
  completedAt DateTime?
  notes      String?
  bookingProgress    ChecklistBookingProgress @default(NOT_STARTED)
  bookedExternallyAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  appointment Appointment?

  @@unique([userId, templateId])
}

model SymptomEntry {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  painLevel   Int?     // 1-10
  symptoms    Json     // e.g. ["cramping", "fatigue"] - stored as JSON array for SQLite
  notes       String?
  syncedToRedcap Boolean @default(false)
  syncedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model AbsenceEntry {
  id        String        @id @default(cuid())
  userId    String
  date      DateTime
  halfDay   Boolean       @default(false)
  reason    AbsenceReason
  context   String?       // "work" | "school"
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SurveyTemplate {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "enrollment_survey", "qol_3m"
  title       String
  description String?
  intervalMonths Int   // 0, 3, 6, 9, 12, 24, 36, etc.
  questions   Json     // Array of question configs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  responses          SurveyResponse[]
  checklistTemplates ChecklistTemplate[]
}

model SurveyResponse {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  answers    Json     // Question id -> answer
  completed  Boolean  @default(false)
  completedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  template SurveyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
}

model Appointment {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  location    String?
  externalUrl String?  // Link to booking
  status      AppointmentStatus @default(CONFIRMED)
  addedToCalendar Boolean @default(false)
  /// Participant-confirmed slot (checklist flow); .ics uses this when set.
  scheduledStartAt   DateTime?
  scheduledLocation  String?
  participantChecklistItemId String? @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  participantChecklistItem ParticipantChecklistItem? @relation(fields: [participantChecklistItemId], references: [id], onDelete: Cascade)
}

model Document {
  id          String       @id @default(cuid())
  userId      String
  type        DocumentType
  title       String
  storageKey  String       // S3/key or upload path
  mimeType    String?
  sizeBytes   Int?
  isReferral  Boolean      @default(false) // Sent by admin to participant
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Weekly school-attendance diary check-in cycle (in-app banner reminders).
enum SchoolAttendanceReminderOutcome {
  AWAITING_RESPONSE
  RESPONDED_NO
  RESPONDED_YES_CONFIRMED
  RESPONDED_YES_ROUTED
  EXPIRED_NO_RESPONSE
}

enum SchoolAttendanceReminderStage {
  INITIAL
  FIRST_FOLLOWUP
  SECOND_FOLLOWUP
}

model SchoolAttendanceReminderCycle {
  id                 String                          @id @default(cuid())
  userId             String
  /// Start of this reminder cycle (ISO week start in production; test cycle anchor).
  cycleStartAt       DateTime
  outcome            SchoolAttendanceReminderOutcome @default(AWAITING_RESPONSE)
  stage              SchoolAttendanceReminderStage   @default(INITIAL)
  initialDueAt       DateTime
  firstFollowUpDueAt DateTime
  secondFollowUpDueAt DateTime
  /// Set when participant dismisses without Yes/No; cleared when stage advances.
  dismissedAt        DateTime?
  respondedAt        DateTime?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, outcome])
  @@index([userId, cycleStartAt])
}

/// Monthly medical-appointments diary check-in cycle (in-app banner reminders).
enum MedicalAppointmentsReminderOutcome {
  AWAITING_RESPONSE
  RESPONDED_NO
  RESPONDED_YES_CONFIRMED
  EXPIRED_NO_RESPONSE
}

enum MedicalAppointmentsReminderStage {
  INITIAL
  FIRST_FOLLOWUP
  SECOND_FOLLOWUP
}

model MedicalAppointmentsReminderCycle {
  id                  String                             @id @default(cuid())
  userId              String
  /// Anchor for this reminder month (used to compute month-end due dates).
  cycleStartAt        DateTime
  outcome             MedicalAppointmentsReminderOutcome @default(AWAITING_RESPONSE)
  stage               MedicalAppointmentsReminderStage   @default(INITIAL)
  initialDueAt        DateTime
  firstFollowUpDueAt  DateTime
  secondFollowUpDueAt DateTime
  dismissedAt         DateTime?
  respondedAt         DateTime?
  createdAt           DateTime                           @default(now())
  updatedAt           DateTime                           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, outcome])
  @@index([userId, cycleStartAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  type      String?  // "appointment", "survey", "referral", etc.
  read      Boolean  @default(false)
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  message   String
  category  String?  // General, Technical, etc.
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NewsPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  excerpt   String?
  published Boolean  @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectSettings {
  id          String   @id @default("default")
  projectName String
  description String   @default("")
  projectId   String   @default("")
  startDate   String   @default("")
  endDate     String   @default("")
  status      String   @default("Active")
  timeZone    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EnrolmentToken {
  id            String    @id @default(cuid())
  token         String    @unique
  studyRecordId String
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())
}

model RedcapParticipantSync {
  id                     String    @id @default(cuid())
  studyRecordId          String    @unique
  firstName              String?
  lastName               String?
  email                  String?
  dateOfBirth            DateTime?
  /// Participant's own consent signature (consent_sigdatetime_u18 / consent_sigdatetime_over18).
  participantConsentDate DateTime?
  /// Parent consent signature (u18 only); null for over18 and when REDCap field unavailable.
  parentConsentDate      DateTime?
  /// Eligibility date for app enrolment: over18 = participantConsentDate; u18 = max(participant, parent).
  enrollmentDate         DateTime?
  dataKind               ParticipantDataKind @default(UNKNOWN)
  redcapType             String?
  consentStatus          String?
  lastSyncedAt           DateTime  @updatedAt
  createdAt              DateTime  @default(now())

  @@map("redcap_participant_sync")
}
