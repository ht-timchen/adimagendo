# Database (SQLite for prototype - no server needed)
# Local: file is created in prisma/ when you run `npx prisma db push`
# Railway: use a volume mounted at /data and set DATABASE_URL="file:/data/dev.db"
DATABASE_URL="file:./dev.db"

# NextAuth v5
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Staff invite / reset password delivery
# manual — admin copies a temporary password (Railway pilot default)
# smtp   — send invite/reset links by email when SMTP vars are set
# If unset: SMTP vars present => smtp; otherwise => manual
#
# Railway pilot: set EMAIL_DELIVERY_MODE=manual. Outbound Gmail SMTP (465/587) timed out
# in our tests; SMTP vars are optional and ignored while mode is manual.
EMAIL_DELIVERY_MODE="manual"
#
# SMTP (optional — only used when EMAIL_DELIVERY_MODE=smtp)
# EMAIL_SERVER_HOST="smtp.gmail.com"
# EMAIL_SERVER_PORT="587"
# EMAIL_SERVER_USER="your@gmail.com"
# EMAIL_SERVER_PASSWORD="your-16-char-app-password"
# EMAIL_FROM="AdImagendo <your@gmail.com>"

# Google Calendar (optional - for Add to Calendar)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# File uploads (local disk)
# Local: leave unset (defaults to ./uploads)
# Railway: set to volume path so uploads persist, e.g. UPLOAD_DIR="/data/uploads"
# UPLOAD_DIR="/data/uploads"
